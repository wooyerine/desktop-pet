{
  "name": "desktop-pet",
  "version": "1.2.2",
  "description": "픽셀 데스크탑 펫 — 같이 일하는 고양이/강아지/토끼",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --mac"
  },
  "keywords": [],
  "author": "wooyerine",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "uiohook-napi": "^1.5.5"
  },
  "build": {
    "appId": "com.wooyerine.desktop-pet",
    "productName": "Desktop Pet",
    "afterPack": "./scripts/adhoc-sign.js",
    "files": [
      "main.js",
      "preload.js",
      "pet.js",
      "index.html",
      "style.css"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "build/icon.png",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ]
    }
  }
}
